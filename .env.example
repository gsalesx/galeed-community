# galeed — variáveis de ambiente (copie para .env; .env é gitignored)

# --- Banco (fonte de verdade única: Postgres + pgvector) ---
# Galeed é DB-native: TODO o estado vive no Postgres. Não há mais arquivos/SQLite.
# Dev local: suba o Postgres+pgvector com `docker compose up -d` e use a URL abaixo.
# Produção: aponte para o seu Supabase (Project Settings → Database → Connection string;
# prefira o Pooler, porta 6543, transaction mode). Percent-encode senhas (# -> %23, @ -> %40...).
DATABASE_URL=postgresql://galeed:galeed@localhost:5434/galeed

# Identidade do tenant/empresa: isola as linhas no mesmo Postgres (coluna `brain`).
# Em multi-tenant, cada empresa tem o seu. Default: "galeed".
GALEED_BRAIN=galeed

# --- Busca semântica (embeddings) ---
# Sem esta chave, a busca cai pra palavra-chave (FTS). Tudo o mais funciona.
# OPENAI_API_KEY=sk-...

# --- LLM (extract/ask) ---
# Por padrão usa assinatura local: CLI `claude` OU ChatGPT/Codex (OAuth no painel Conectar;
# tokens no Postgres. `~/.codex/auth.json` só como fallback de dev local).
# Forçar ChatGPT (mesmo caminho do Hermes openai-codex):
#   GALEED_PROVIDER=codex
#   GALEED_CLI_BACKEND=codex
#   GALEED_CODEX_MODEL=gpt-5.4-mini
# Sem assinatura local, defina a API Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Evolution API (WhatsApp) — profile docker "evolution" ---
# Compose (Galeed+Evolution juntos):
#   EVOLUTION_API_URL=http://evolution:8080
#   EVOLUTION_WEBHOOK_BASE=http://gateway:8790
# Dev (Galeed no host + Evolution no Docker):
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=galeed-local-evolution-key
EVOLUTION_WEBHOOK_BASE=http://host.docker.internal:8790

# --- Webhook de ingestão (galeed serve) ---
# INGEST_TOKEN=um-token-secreto
# PORT=8787
