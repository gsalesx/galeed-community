# ───────────────────────────────────────────────────────────────────────────
# Galeed — variáveis de ambiente do stack Docker.
# Uso:  cp .env.docker.example .env   e preencha os segredos.
#
# O docker-compose lê este arquivo (env_file) mas SOBRESCREVE, dentro do
# contêiner, DATABASE_URL / GALEED_SCHEMA_PACK / GALEED_BLOB_DIR pelos valores
# internos (db:5432, /app/..., /data/blobs). Os demais valem como estão aqui.
# ───────────────────────────────────────────────────────────────────────────

# ── Obrigatórias ────────────────────────────────────────────────────────────
# Só usado FORA do Docker (dev na :5434). No compose, o banco é o serviço `db`.
DATABASE_URL=postgresql://galeed:galeed@localhost:5434/galeed
# Cérebro/tenant padrão
GALEED_BRAIN=galeed
# LLM (extração · síntese · reflexão) e embeddings (busca semântica)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Ingress / borda pública (Caddy) ─────────────────────────────────────────
# ":80" = HTTP local. Um domínio (ex.: galeed.suaempresa.com) liga HTTPS/HSTS
# automático no Caddy (emite e renova o certificado sozinho).
GALEED_SITE_ADDRESS=:80
# Portas do host pro ingress (default 80/443). Em dev sem privilégio: 8080/8443.
GALEED_HTTP_PORT=80
GALEED_HTTPS_PORT=443

# ── Segurança (produção) ────────────────────────────────────────────────────
# Prefixo dos tokens públicos do gateway
GALEED_TOKEN_PREFIX=gld_live_
# Teto diário de custo de LLM por brain no /v1/ask (responde 402 ao estourar)
GALEED_LLM_DAILY_BUDGET_USD=25
# RLS no banco. Em PROD use 1 + um ROLE não-superuser na DATABASE_URL
# (o role `galeed` default é superuser e BYPASSA o RLS).
GALEED_RLS=0
# Cookie de sessão com flag Secure. 0 local (HTTP); 1 em PROD (HTTPS via domínio) —
# navegador descarta cookie Secure sobre HTTP, então local TEM que ser 0.
GALEED_SECURE_COOKIES=0
# TRUST_PROXY/SECURE_COOKIES já são forçados nos serviços pelo compose.

# ── Opcionais (têm default no código) ───────────────────────────────────────
# Reranker (Voyage). Sem chave, cai no fallback sem rerank.
VOYAGE_API_KEY=
# Modelos (deixe em branco pra usar os defaults do código)
# ANTHROPIC_MODEL=
# GALEED_EMBED_MODEL=
# Token do ingest-server legado (o /v1/ingest do gateway usa Bearer gld_)
# INGEST_TOKEN=
# Webhooks
# GALEED_WEBHOOK_MAX_RETRIES=8
# GALEED_WEBHOOK_TIMEOUT_MS=8000
# Blob store: 'supabase' em produção (default = filesystem no volume galeed-blobs)
# GALEED_BLOB_DRIVER=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GALEED_BLOB_BUCKET=

# ── Evolution API (WhatsApp) — profile "evolution" no docker-compose ────────
# Sobe com: docker compose --profile app --profile evolution up -d --build
# Manager no host: http://localhost:8080  |  apikey = EVOLUTION_API_KEY
EVOLUTION_HTTP_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=galeed-local-evolution-key
# BFF (dentro do compose) fala com a Evolution pelo hostname do serviço:
EVOLUTION_API_URL=http://evolution:8080
# Evolution chama o gateway do Galeed na rede interna:
EVOLUTION_WEBHOOK_BASE=http://gateway:8790

# ── Stripe (billing) ────────────────────────────────────────────────────────
# Dev/local: chaves de TEST (sk_test_/pk_test_). PROD: chaves live, só no secret
# store do servidor — nunca commitadas, nunca em chat. pk_ é pública (vai no front).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# whsec_ do endpoint de webhook (Dashboard ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# NFS-e via Spedy (plano Avançado+ p/ API). Caminho A (conector nativo no painel) não usa isto.
# Vazio = no-op (não emite nota). Ativar exige confirmar o contrato da API + config fiscal da empresa.
# SPEDY_API_TOKEN=
# SPEDY_API_BASE=https://api.spedy.com.br
# SPEDY_FEDERAL_SERVICE_CODE=   # item da lista LC 116/03
# SPEDY_CITY_SERVICE_CODE=      # código municipal do serviço
# SPEDY_CNAE_CODE=
# SPEDY_ISS_RATE=               # alíquota ISS (ex.: 2.0)
